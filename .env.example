# Public site state. Keep false until an intentional public launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_LAUNCH=false

# Optional external contribution page. HTTPS only; omit to hide the external CTA.
NEXT_PUBLIC_SUPPORT_URL=https://buymeacoffee.com/madebyhakim

# Optional account and cloud-list services.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=

# Optional Plus billing. Keep false while Plus is a waitlist.
PLUS_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# Comma-separated Clerk user IDs allowed to review private submissions.
ADMIN_USER_IDS=
